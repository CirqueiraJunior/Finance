QMainWindow, QWidget {
    background: #f5f7fa;
    color: #1f2937;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QFrame#sidebar {
    background: #1b2a63;
}

QPushButton#navigationButton,
QPushButton#sidebarActionButton {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 9px;
    color: #f4f7ff;
    padding: 9px 12px;
    text-align: left;
    font-family: "Segoe UI";
    font-size: 10pt;
    font-weight: 500;
    min-height: 26px;
}

QPushButton#navigationButton:hover,
QPushButton#sidebarActionButton:hover {
    background: rgba(74, 119, 255, 0.22);
    border: 1px solid rgba(147, 197, 253, 0.55);
    color: #ffffff;
}

QPushButton#navigationButton:pressed,
QPushButton#sidebarActionButton:pressed {
    background: rgba(74, 119, 255, 0.30);
}

QPushButton#navigationButton:checked {
    background: #2d64f1;
    border: 1px solid #8db4ff;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#navigationButton:focus,
QPushButton#sidebarActionButton:focus {
    border: 1px solid #93c5fd;
}

QFrame#sidebarSeparator {
    background: rgba(255, 255, 255, 0.35);
    border: none;
    margin-top: 5px;
    margin-bottom: 5px;
}

QFrame#appHeader {
    background: #0f4f86;
    border-bottom: 3px solid #d2a52e;
}
QLabel#headerLogo,
QLabel#headerTagline,
QLabel#headerUser,
QLabel#headerVersion {
    background: transparent;
    border: none;
}
QLabel#headerTagline {
    color: #ffffff;
    font-family: "Segoe UI";
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0px;
}
QLabel#headerUser {
    color: #ffffff;
    font-size: 9.5pt;
    font-weight: 600;
    padding: 0;
    margin: 0;
}
QPushButton#headerLogout {
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 8px;
    color: #ffffff;
    padding: 7px 15px;
    min-height: 18px;
    font-weight: 600;
}
QPushButton#headerLogout:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.60);
}
QPushButton#headerLogout:pressed { background: rgba(0, 0, 0, 0.12); }
QPushButton#headerLogout:focus { border: 1px solid #ffffff; }
QLabel#headerVersion {
    color: #f1f5ff;
    font-size: 10pt;
    font-weight: 600;
}

QFrame#topbar { background: #ffffff; border-bottom: 1px solid #e5e7eb; }
QLabel#topbarTitle { color: #172554; font-size: 13pt; font-weight: 600; }
QWidget#contentPage { background: #f5f7fa; }
QLabel#pageTitle { color: #003B71; font-size: 30px; font-weight: 700; }
QLabel#pageDescription { color: #4A5568; font-size: 16px; }
QLabel#sectionTitle {
    color: #172554;
    font-size: 11pt;
    font-weight: 600;
    margin-top: 8px;
}
QLabel#operationStatus {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 6px;
    color: #065f46;
    padding: 8px;
}
QLabel#operationStatus[error="true"] {
    background: #fef2f2;
    border-color: #fecaca;
    color: #991b1b;
}
QWidget#summaryCard {
    background: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
}
QLabel#summaryLabel { color: #6b7280; font-size: 10pt; }
QLabel#summaryValue { color: #172554; font-size: 15pt; font-weight: 700; }

QLineEdit, QPlainTextEdit, QTableWidget {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #64748b;
    border-radius: 8px;
    background: #ffffff;
}
QRadioButton::indicator:checked {
    border: 4px solid #93c5fd;
    background: #1d4ed8;
}
QRadioButton::indicator:unchecked:disabled {
    border-color: #cbd5e1;
    background: #f8fafc;
}

/* ============================================================
   BUTTONS ? J.A. Technology / Control Center visual standard
   ============================================================ */

QPushButton {
    background: #ffffff;
    color: #17324d;
    border: 1px solid #c9d4df;
    border-radius: 8px;
    padding: 8px 16px;
    min-height: 22px;
    font-weight: 500;
}

QPushButton:hover {
    background: #f4f7fa;
    border-color: #9fb3c8;
}

QPushButton:pressed {
    background: #e9eef4;
    border-color: #829ab1;
}

QPushButton:focus {
    border: 2px solid #6d9fc7;
}

/* Prim?rio */
QPushButton[buttonRole="primary"],
QPushButton#primaryButton {
    background: #0b4a7f;
    border: 1px solid #0b4a7f;
    color: #ffffff;
    font-weight: 600;
}

QPushButton[buttonRole="primary"]:hover,
QPushButton#primaryButton:hover {
    background: #083d69;
    border-color: #083d69;
}

QPushButton[buttonRole="primary"]:pressed,
QPushButton#primaryButton:pressed {
    background: #062f52;
    border-color: #062f52;
}

/* Secund?rio */
QPushButton[buttonRole="secondary"] {
    background: #ffffff;
    color: #17324d;
    border: 1px solid #c9d4df;
}

QPushButton[buttonRole="secondary"]:hover {
    background: #f4f7fa;
    border-color: #9fb3c8;
}

/* Toolbar */
QPushButton[buttonRole="toolbar"] {
    background: #ffffff;
    color: #17324d;
    border: 1px solid #9fb3c8;
    padding: 7px 14px;
}

QPushButton[buttonRole="toolbar"]:hover {
    background: #edf4f8;
    border-color: #6d9fc7;
}

/* Informa??o / gest?o */
QPushButton[buttonRole="info"] {
    background: #eaf3f9;
    color: #0b4a7f;
    border: 1px solid #7fa8c7;
    font-weight: 500;
}

QPushButton[buttonRole="info"]:hover {
    background: #dcecf6;
    border-color: #5f91b6;
}

QPushButton[buttonRole="info"]:pressed {
    background: #cfe3f0;
    border-color: #4f7fa2;
}

/* Aten??o / ativa??o */
QPushButton[buttonRole="warning"] {
    background: #fff8df;
    color: #765900;
    border: 1px solid #e0aa00;
    font-weight: 600;
}

QPushButton[buttonRole="warning"]:hover {
    background: #fff1bf;
    border-color: #c89500;
}

QPushButton[buttonRole="warning"]:pressed {
    background: #f5e49f;
    border-color: #aa7e00;
}

/* Perigo */
QPushButton[buttonRole="danger"] {
    background: #b42318;
    border: 1px solid #b42318;
    color: #ffffff;
    font-weight: 600;
}

QPushButton[buttonRole="danger"]:hover {
    background: #912018;
    border-color: #912018;
}

QPushButton[buttonRole="danger"]:pressed {
    background: #761b14;
    border-color: #761b14;
}

/* Desabilitado */
QPushButton:disabled,
QPushButton[buttonRole="primary"]:disabled,
QPushButton#primaryButton:disabled,
QPushButton[buttonRole="secondary"]:disabled,
QPushButton[buttonRole="toolbar"]:disabled,
QPushButton[buttonRole="info"]:disabled,
QPushButton[buttonRole="warning"]:disabled {
    background: #eef1f4;
    color: #9aa6b2;
    border: 1px solid #d8dee5;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e5e7eb;
    color: #4b5563;
}



/* GLOBAL TABS - J.A. TECHNOLOGY */

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d8e1ec;
    border-radius: 9px;
    top: -1px;
}

QTabBar::tab {
    background: #edf3f8;
    color: #29445f;
    border: 1px solid #d2dce7;
    border-bottom: 2px solid #d2dce7;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 34px;
    padding: 8px 18px;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:hover:!selected {
    background: #dfeaf4;
    color: #0b4a7f;
    border-color: #9fb7cd;
}

QTabBar::tab:selected {
    background: #0b4a7f;
    color: #ffffff;
    border: 1px solid #0b4a7f;
    border-bottom: 3px solid #d9aa00;
    font-weight: 600;
}

QTabBar::tab:disabled {
    background: #eef1f4;
    color: #9aa6b2;
    border-color: #d8dee5;
}

/* ============================================================
   DASHBOARD — PADRÃO VISUAL J.A. TECHNOLOGY
   ============================================================ */

QTabWidget#dashboardTabs {
    background: transparent;
    border: none;
}
QTabWidget#dashboardTabs::pane {
    background: #ffffff;
    border: 1px solid #d8e1ec;
    border-radius: 10px;
    top: -1px;
}
QTabWidget#dashboardTabs QTabBar::tab {
    background: #eef3f8;
    color: #33516f;
    border: 1px solid #d8e1ec;
    border-bottom: 2px solid #d8e1ec;
    min-width: 128px;
    min-height: 34px;
    padding: 7px 18px;
    margin-right: 4px;
    font-size: 10pt;
    font-weight: 600;
}
QTabWidget#dashboardTabs QTabBar::tab:first {
    border-top-left-radius: 8px;
}
QTabWidget#dashboardTabs QTabBar::tab:last {
    border-top-right-radius: 8px;
}
QTabWidget#dashboardTabs QTabBar::tab:hover:!selected {
    background: #e2edf8;
    color: #003B71;
    border-color: #9db7d0;
}
QTabWidget#dashboardTabs QTabBar::tab:selected {
    background: #0f4f86;
    color: #ffffff;
    border: 1px solid #0f4f86;
    border-bottom: 3px solid #d2a52e;
    font-weight: 700;
}
QTabWidget#dashboardTabs QTabBar::tab:focus {
    border: 1px solid #60a5fa;
}

QWidget#dashboardFilterBar {
    background: #edf3f8;
    border: 1px solid #d7e1eb;
    border-radius: 8px;
    padding: 6px 8px;
}
QWidget#dashboardFilterBar QLabel {
    background: transparent;
    color: #29445f;
    font-weight: 600;
}
QWidget#dashboardFilterBar QComboBox,
QWidget#dashboardFilterBar QSpinBox {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #b9c9d9;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 20px;
}
QWidget#dashboardFilterBar QComboBox:hover,
QWidget#dashboardFilterBar QSpinBox:hover {
    border-color: #5f8fba;
}
QWidget#dashboardFilterBar QComboBox:focus,
QWidget#dashboardFilterBar QSpinBox:focus {
    border: 2px solid #2d64f1;
}
QWidget#dashboardFilterBar QComboBox::drop-down {
    border: none;
    width: 24px;
}

QWidget#summaryCard {
    background: #ffffff;
    border: 1px solid #d7e1eb;
    border-radius: 10px;
}
QWidget#summaryCard:hover {
    border-color: #9db7d0;
    background: #fbfdff;
}
QWidget#summaryCard[cardRole="balance"] {
    background: #eef6fb;
    border: 1px solid #9fc0dc;
}
QWidget#summaryCard[cardRole="revenue"] {
    background: #eef5ff;
    border: 1px solid #a8c6f2;
}
QWidget#summaryCard[cardRole="expense"] {
    background: #fff4f3;
    border: 1px solid #f1b9b5;
}
QWidget#summaryCard[cardRole="movement"] {
    background: #fff9e9;
    border: 1px solid #e4cf8d;
}
QWidget#summaryCard[cardRole="boe"] {
    background: #eef7f9;
    border: 1px solid #a8ced4;
}
QWidget#summaryCard[cardRole="target"] {
    background: #f4f2fb;
    border: 1px solid #c8bceb;
}
QWidget#summaryCard[cardRole="performance"] {
    background: #fff8e7;
    border: 1px solid #dfc573;
}
QWidget#summaryCard QLabel {
    background: transparent;
}
QLabel#summaryLabel {
    color: #52677d;
    font-size: 9.5pt;
    font-weight: 600;
}
QLabel#summaryValue {
    color: #0f2f55;
    font-size: 16pt;
    font-weight: 700;
}

QLabel#sectionTitle {
    color: #0f3d68;
    font-size: 12pt;
    font-weight: 700;
    margin-top: 10px;
    margin-bottom: 3px;
}

QTableWidget#dashboardBudgetTable,
QWidget#dashboardBoeTab QTableWidget {
    background: #ffffff;
    border: 1px solid #d7e1eb;
    border-radius: 8px;
    gridline-color: #e5ebf2;
    alternate-background-color: #f8fafc;
}
QTableWidget#dashboardBudgetTable::item:selected,
QWidget#dashboardBoeTab QTableWidget::item:selected {
    background: #dcecff;
    color: #0f3d68;
}

QChartView {
    background: #ffffff;
    border: 1px solid #d7e1eb;
    border-radius: 10px;
}
